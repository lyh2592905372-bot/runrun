NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-secret
SPORT_WORLD_CREDENTIAL_KEY=replace-with-a-long-random-secret
SPORT_WORLD_PROVIDER=official
SPORT_WORLD_OFFICIAL_BASE_URL=https://run.gxapp.iydsj.com
SPORT_WORLD_API_TIMEOUT_MS=15000
# Optional: leave empty when Chromium was installed through playwright-core.
SPORT_WORLD_CHROMIUM_PATH=
SPORT_WORLD_GEETEST_CAPTCHA_ID=3b02ad39bd099fd3a8336d9347a189ab
SPORT_WORLD_GEETEST_MAX_RETRIES=3
SPORT_WORLD_GEETEST_TIMEOUT_MS=30000
SPORT_WORLD_CRON_INTERVAL_MINUTES=30

# Optional: use an authorized read-only proxy instead of the built-in official client.
# SPORT_WORLD_PROVIDER=proxy
# SPORT_WORLD_LOGIN_URL=
# SPORT_WORLD_VALIDATE_URL=
# SPORT_WORLD_PROGRESS_URL=
# SPORT_WORLD_HISTORY_URL=
