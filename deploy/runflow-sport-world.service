[Unit]
Description=Synchronize enabled Sport World accounts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/var/www/runflow/.env.production
ExecStart=/usr/bin/curl --fail --silent --show-error --retry 2 -H "Authorization: Bearer ${CRON_SECRET}" ${NEXT_PUBLIC_APP_URL}/api/cron/sport-world
User=runflow
Group=runflow
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
