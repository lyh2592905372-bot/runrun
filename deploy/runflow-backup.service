[Unit]
Description=Create Snowflake Sports Supabase JSON snapshot when due
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/var/www/runflow/.env.production
ExecStart=/usr/bin/curl --fail --silent --show-error --retry 2 -H "Authorization: Bearer ${CRON_SECRET}" https://xuehuayd.top/api/cron/backup
User=runflow
Group=runflow
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
